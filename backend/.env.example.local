# APP NAME
APP_NAME=Web app starter
# PORT
PORT=3001
# Base prefix to be added to all end-points
BASE_URL_PREFIX=/api
# Sundsvalls kommun API end-point
API_BASE_URL=https://api-test.sundsvall.se
# Credentials used for API
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# SAML
# Backend URLs - full URLS
SAML_CALLBACK_URL=http://localhost:3001/api/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/logout/callback
SAML_FAILURE_REDIRECT=http://localhost:3001/api/saml/login

SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_PRIVATE_KEY}}\n-----END PRIVATE KEY-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_PUBLIC_CERT}}\n-----END CERTIFICATE-----\n"

# Group considered admins
ADMIN_GROUP=""

# Group considered admins on their org level
DEPARTMENT_ADMIN_GROUP=""

# Group considered developers
DEVELOPER_GROUP=""

#Default municipality id
MUNICIPALITY_ID=2281

# Used for session encryption - generate a random string per environment
SECRET_KEY={{INSERT_RANDOM_SECRET}}

# Swagger
SWAGGER_ENABLED=true

# Session store: memory (default, local dev) | file (./data/sessions) | redis (OpenShift / multi-pod)
SESSION_STORE=memory

# Redis - only required when SESSION_STORE=redis (set via Deployment/Helm in OpenShift)
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# LOG - for prod use "combined" LOG_FORMAT
LOG_FORMAT=dev
LOG_DIR=../../data/logs

# CORS
ORIGIN=http://localhost:3000
CREDENTIALS=true
